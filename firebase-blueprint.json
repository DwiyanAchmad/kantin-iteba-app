{
  "entities": {
    "RestaurantConfig": {
      "title": "RestaurantConfig",
      "description": "Configuration metadata for the restaurant, including location Coordinates and geofence",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "geofenceRadiusMeters": {
          "type": "number"
        }
      },
      "required": ["name", "address", "latitude", "longitude", "geofenceRadiusMeters"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Dishes, beverages, and snacks served by the restaurant",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "enum": ["food", "drink", "snack", "dessert"]
        },
        "image": {
          "type": "string"
        },
        "stock": {
          "type": "number"
        },
        "isAvailable": {
          "type": "boolean"
        },
        "popular": {
          "type": "boolean"
        },
        "salesCount": {
          "type": "number"
        }
      },
      "required": ["id", "name", "description", "price", "category", "image", "stock", "isAvailable", "popular", "salesCount"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order records containing cart items, payment info, and geofence confirmation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "items": {
          "type": "array"
        },
        "totalAmount": {
          "type": "number"
        },
        "orderType": {
          "type": "string",
          "enum": ["dine-in", "pickup"]
        },
        "tableNo": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "processing", "completed", "cancelled"]
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["qris", "ewallet", "card", "cash"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["pending", "paid", "failed"]
        },
        "customerName": {
          "type": "string"
        },
        "customerPhone": {
          "type": "string"
        },
        "distanceInMeters": {
          "type": "number"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": ["id", "items", "totalAmount", "orderType", "status", "paymentMethod", "paymentStatus", "customerName", "customerPhone", "timestamp"]
    },
    "KitchenNotification": {
      "title": "KitchenNotification",
      "description": "Notifications pushed to the kitchen and admin board whenever a new order is received",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "orderId": {
          "type": "string"
        },
        "customerName": {
          "type": "string"
        },
        "orderType": {
          "type": "string",
          "enum": ["dine-in", "pickup"]
        },
        "tableNo": {
          "type": "string"
        },
        "itemsSummary": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "read": {
          "type": "boolean"
        }
      },
      "required": ["id", "orderId", "customerName", "orderType", "itemsSummary", "timestamp", "read"]
    }
  },
  "firestore": {
    "config/restaurant": {
      "schema": "RestaurantConfig",
      "description": "Single document representing the singleton restaurant geofence configurations"
    },
    "menuItems/{itemId}": {
      "schema": "MenuItem",
      "description": "Collection of items available on the restaurant's menu"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of orders generated by customers"
    },
    "notifications/{notificationId}": {
      "schema": "KitchenNotification",
      "description": "Collection of backend notifications"
    }
  }
}
